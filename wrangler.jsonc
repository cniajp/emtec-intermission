{
  // Cloudflare Workers configuration for OpenNext deployment
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "emtec-intermission",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev 側のプレビューURLも発行する。
  // Worker Previews (wrangler preview) は <preview名>-emtec-intermission.<subdomain>.workers.dev、
  // wrangler versions upload は <version>-emtec-intermission.<subdomain>.workers.dev (Version URL)
  "preview_urls": true,
  "build": {
    "command": "pnpm run build:cloudflare"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "im.emtec.tv",
      "custom_domain": true
    },
    // Worker Previews (wrangler preview) 専用のドメイン。本番 (wrangler deploy) には当てない。
    // プレビューは <preview名>.dev-im.emtec.tv、デプロイごとは <deployment-id>-<preview名>.dev-im.emtec.tv で配信され、
    // ワイルドカードの DNS レコードと証明書 (*.dev-im.emtec.tv) は Cloudflare が作る
    {
      "pattern": "dev-im.emtec.tv",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ],
  // Worker Previews (wrangler preview) 用の設定。トップレベルは本番、ここはプレビューに効く。
  // 本番と分けたい vars / bindings が出てきたらここに書く。分けるものが無い間は空でよいが、
  // ブロック自体は Worker Previews を使うために必要 (Wrangler 4.135.0 以上)
  "previews": {}
}
