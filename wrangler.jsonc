{
  // Cloudflare Workers configuration for OpenNext deployment
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "emtec-intermission",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  // wrangler versions upload したバージョンごとに
  // <version>-emtec-intermission.<subdomain>.workers.dev のプレビューURLを発行する
  "preview_urls": true,
  "build": {
    "command": "npm run build:cloudflare"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "im.emtec.tv",
      "custom_domain": true
    },
    // Worker Previews (wrangler preview) 専用のドメイン。本番 (wrangler deploy) には当てない。
    // プレビューは <preview名>.dev-im.emtec.tv、デプロイごとは <deployment-id>-<preview名>.dev-im.emtec.tv で配信され、
    // ワイルドカードの DNS レコードと証明書 (*.dev-im.emtec.tv) は Cloudflare が作る
    {
      "pattern": "dev-im.emtec.tv",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ]
}
