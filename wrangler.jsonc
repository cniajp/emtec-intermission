{
  // Cloudflare Workers configuration for OpenNext deployment
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "emtec-intermission",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  // wrangler versions upload したバージョンごとに
  // <version>-emtec-intermission.<subdomain>.workers.dev のプレビューURLを発行する
  "preview_urls": true,
  "build": {
    "command": "npm run build:cloudflare"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "im.emtec.tv",
      "custom_domain": true
    }
  ],
  // プレビュー用の環境。本番とは別の Worker (emtec-intermission-preview) としてデプロイし、
  // dev-im.emtec.tv を当てる。カスタムドメインは Worker 単位でしか当てられず、
  // 上の preview_urls が発行するバージョンごとの URL には付けられないため環境を分けている。
  // デプロイ: npm run deploy:preview (= wrangler deploy --env preview)
  // routes は環境ごとに上書きされるので、本番の im.emtec.tv はこの環境には付かない
  "env": {
    "preview": {
      "name": "emtec-intermission-preview",
      "routes": [
        {
          "pattern": "dev-im.emtec.tv",
          "custom_domain": true
        }
      ]
    }
  }
}
