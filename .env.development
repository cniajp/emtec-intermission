NEXT_PUBLIC_API_BASE_URL=http://localhost:8888/
# NEXT_PUBLIC_API_BASE_URL=https://event.cloudnativedays.jp/
NEXT_PUBLIC_EVENT_ABBR=pde2026
NEXT_PUBLIC_DK_EVENT_ABBR=cnk
NEXT_PUBLIC_DEBUG='true'
NEXT_PUBLIC_EXCLUDED_TALKS='9999'

# ページ表示時間の基本値は src/staticConfig/*.ts（page1.seconds / page2.seconds / page3.secondsPerImage）。
# NEXT_PUBLIC_TRANS_TIME_PAGE* はビルドせずに一時上書きする用（PAGE3 は「1枚あたり」の秒数）。
# NEXT_PUBLIC_TRANS_TIME_PAGE1='32.5'
# NEXT_PUBLIC_TRANS_TIME_PAGE2='32.5'
# NEXT_PUBLIC_TRANS_TIME_PAGE3='10'
